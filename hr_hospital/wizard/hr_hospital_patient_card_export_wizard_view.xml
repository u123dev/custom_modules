<odoo>
    <record id="hr_hospital_patient_card_export_wizard_action" model="ir.actions.act_window">
        <field name="name">Export Patient Card</field>
        <field name="res_model">hr.hospital.patient.card.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="hr_hospital_patient_card_export_wizard_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.card.export.wizard.form</field>
        <field name="model">hr.hospital.patient.card.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Patient Card">

                <group name="patient_info">
                    <field name="patient_id" readonly="1" string="Patient"/>
                </group>

                <group name="filters" string="Date Range and Content">
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                    <group>
                        <field name="include_diagnoses"/>
                        <field name="include_recommendations"/>
                    </group>
                </group>

                <group name="settings" string="Export Settings">
                    <field name="export_format"/>
                    <field name="report_language_id"/>
                </group>

                <footer>
                    <button name="action_export_card" string="Export" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_hospital_patient_form_inherit_wizard" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form.inherit.wizard</field>
        <field name="model">hr.hospital.patient</field>
        <field name="inherit_id" ref="hr_hospital.hr_hospital_patient_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(hr_hospital_patient_card_export_wizard_action)d"
                            string="Export Card"
                            type="action"
                            class="oe_highlight"
                            context="{'default_patient_id': active_id}"/>
                </header>
            </xpath>

        </field>
    </record>

</odoo>
