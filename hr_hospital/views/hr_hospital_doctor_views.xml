<odoo>
    <!-- TREE VIEW -->
    <record id="hr_hospital_doctor_tree" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.tree</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="speciality_id"/>
                <field name="work_experience"/>
                <field name="phone"/>
                <field name="is_intern"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="hr_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.form</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options='{"preview_image": "image_128"}'/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <notebook>

                        <!-- TAB: General Info (Inherited fields) -->
                        <page name="general_info" string="General Info">
                            <group>
                                <group string="Personal Data">
                                    <field name="last_name"/>
                                    <field name="first_name"/>
                                    <field name="middle_name"/>
                                    <field name="gender"/>
                                    <field name="birth_date"/>
                                    <field name="age" readonly="1"/>
                                    <field name="country_id"/>
                                </group>
                                <group string="Contact Details">
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="language_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB: Professional Info -->
                        <page name="professional" string="Professional">
                            <group>
                                <group string="Licensing &amp; System">
                                    <field name="speciality_id"/>
                                    <field name="user_id"/>
                                    <field name="license_number"/>
                                    <field name="license_issue_date"/>
                                </group>
                                <group string="Experience &amp; Rating">
                                    <field name="work_experience" readonly="1"/>
                                    <field name="rating"/>
                                    <field name="country_of_study_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB: Internship Details -->
                        <page name="internship" string="Internship">
                            <group>
                                <field name="is_intern"/>
                                <field name="mentor_id"/>

                            </group>
                        </page>

                        <!-- TAB: Work Schedule -->
                        <page name="schedule" string="Schedule">
                            <field name="schedule_ids">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="weekday"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="schedule_type"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_doctor_action_window" model="ir.actions.act_window">
        <field name="name">Doctor</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create first doctor's record
            </p>
        </field>
    </record>

    <menuitem id="hr_hospital_doctor_menu"
              name="Doctor"
              parent="hr_hospital_menu_root"
              action="hr_hospital_doctor_action_window"
              sequence="20"/>

</odoo>
