<odoo>
    <!-- TREE VIEW -->
    <record id="hr_hospital_visit_tree" model="ir.ui.view">
        <field name="name">hr.hospital.visit.tree</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="planned_datetime"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="visit_status" widget="badge" decoration-success="visit_status == 'completed'" decoration-warning="visit_status == 'planned'" decoration-danger="visit_status in ('cancelled', 'missed')"/>
                <field name="visit_cost" widget="monetary"/>
                <field name="diagnosis_count"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="hr_hospital_visit_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.form</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Visit Details">
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="visit_type"/>
                            <field name="visit_status"/>
                        </group>
                        <group string="Timing and Cost">
                            <field name="planned_datetime"/>
<!--                            <field name="actual_datetime"/>-->
                            <field name="actual_datetime" readonly="visit_status in ('completed', 'missed')"/>
                            <field name="visit_cost" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="diagnosis_count"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="diagnosis_recommendations" string="Diagnosis &amp; Recommendations">
                            <separator string="Diagnoses"/>
                            <field name="diagnosis_ids">
                                <tree editable="bottom">
                                    <field name="disease_id"/>
                                    <field name="severity_level" widget="badge" decoration-warning="severity_level == 'medium'" decoration-danger="severity_level in ('hard', 'critical')"/>
                                    <field name="is_approved" widget="toggle_button"/>
                                    <field name="diagnosis_description" optional="hide"/>
                                </tree>
                            </field>

                            <separator string="Recommendations"/>
                            <field name="recommendations" widget="html"/>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_visit_action_window" model="ir.actions.act_window">
        <field name="name">Visit</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register first patient's vist.
            </p>
        </field>
    </record>

    <menuitem id="hr_hospital_visit_menu"
              name="Visit"
              parent="hr_hospital_menu_root"
              action="hr_hospital_visit_action_window"
              sequence="40"/>

</odoo>
