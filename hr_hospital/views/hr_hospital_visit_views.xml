<odoo>
    <!-- TREE VIEW -->
    <record id="hr_hospital_visit_tree" model="ir.ui.view">
        <field name="name">hr.hospital.visit.tree</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="planned_datetime"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="visit_status" widget="badge"
                       decoration-success="visit_status == 'completed'"
                       decoration-warning="visit_status == 'planned'"
                       decoration-danger="visit_status in ('cancelled', 'missed')"/>
                <field name="visit_cost" widget="monetary"/>
                <field name="diagnosis_count"/>
                <field name="activity_ids" widget="list_activity"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="hr_hospital_visit_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.form</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="visit_status" widget="statusbar"
                           options="{'clickable': '1',
                           'colors': {'planned': 'info',
                           'completed': 'success',
                           'cancelled': 'danger',
                           'missed': 'danger'}}"/>
                </header>

                <sheet>
                    <group>
                        <group string="Visit Details">
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="visit_type"/>
<!--                            <field name="visit_status"/>-->
                        </group>
                        <group string="Timing and Cost">
                            <field name="planned_datetime"/>
<!--                            <field name="actual_datetime"/>-->
                            <field name="actual_datetime"
                                   readonly="visit_status in ('completed', 'missed')"/>
                            <field name="visit_cost" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="diagnosis_count"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="diagnosis_recommendations" string="Diagnosis &amp; Recommendations">
                            <separator string="Diagnoses"/>
                            <field name="diagnosis_ids">
                                <tree editable="bottom">
                                    <field name="disease_id"/>
                                    <field name="severity_level" widget="badge"
                                           decoration-warning="severity_level == 'medium'"
                                           decoration-danger="severity_level in ('hard', 'critical')"/>
                                    <field name="is_approved" widget="toggle_button"/>
                                    <field name="diagnosis_description" optional="hide"/>
                                </tree>
                            </field>

                            <separator string="Recommendations"/>
                            <field name="recommendations" widget="html"/>
                        </page>

                    </notebook>
                </sheet>

                <!-- CHATTER for log and followers -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- CALENDAR VIEW -->
    <record id="hr_hospital_visit_calendar" model="ir.ui.view">
        <field name="name">hr.hospital.visit.calendar</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <calendar string="Patient Visits"
                      mode="month"
                      date_start="planned_datetime"
                      color="doctor_id">
                <field name="patient_id"/>
                <field name="doctor_id" avatar_field="image_128"/>
                <field name="visit_status" filters="True"/>
            </calendar>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="hr_hospital_visit_search" model="ir.ui.view">
        <field name="name">hr.hospital.visit.search</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <search string="Visit Search">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="visit_status"/>
                <field name="visit_type"/>

                <group expand="0" string="Group By">
                    <filter name="group_by_status" string="By Status" context="{'group_by': 'visit_status'}"/>
                    <filter name="group_by_doctor" string="By Doctor" context="{'group_by': 'doctor_id'}"/>
                </group>

                <filter string="Planned" name="planned" domain="[('visit_status', '=', 'planned')]"/>
                <filter string="Completed" name="completed" domain="[('visit_status', '=', 'completed')]"/>
                <separator/>
                <filter name="Date" date="planned_datetime"/>
                <separator/>
                <filter string="Current Month" name="filter_current_month"
                        domain="[('planned_datetime', '&gt;=', datetime.datetime.now().strftime('%Y-%m-01')),
                                 ('planned_datetime', '&lt;=', (datetime.datetime.now() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

    <!-- PIVOT VIEW -->
    <record id="hr_hospital_visit_pivot" model="ir.ui.view">
        <field name="name">hr.hospital.visit.pivot</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visit Analysis" display_quantity="1">
                <field name="doctor_id" type="row"/>
                <field name="visit_status" type="col"/>
                <field name="visit_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="hr_hospital_visit_action_window" model="ir.actions.act_window">
        <field name="name">Visit</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">tree,form,calendar,pivot,search</field>
        <!-- Filters by default -->
        <field name="context">{
            'search_default_filter_current_month': 1,
            'search_default_planned': 1,
            'initial_date': "2025-10-02 08:00:00",
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register first patient's vist.
            </p>
        </field>
    </record>

    <menuitem id="hr_hospital_visit_menu"
              name="Visit"
              parent="hr_hospital_menu_root"
              action="hr_hospital_visit_action_window"
              sequence="30"/>

</odoo>
