<odoo>

    <record id="hr_hospital_action_create_visit" model="ir.actions.act_window">
        <field name="name">Quick Visit Creation</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- TREE VIEW -->
    <record id="hr_hospital_patient_tree" model="ir.ui.view">
        <field name="name">hr.hospital.patient.tree</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="personal_doctor_id"/>
                <field name="blood_group"/>
                <field name="phone"/>
                <field name="email"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_view_visits" string="View visits"
                            type="object" class="oe_highlight"/>
                    <button name="%(hr_hospital_action_create_visit)d" string="Quick Visit"
                            type="action" class="oe_highlight"
                            context="{'default_patient_id': active_id}"
                            data-hotkey="q"/>
                    <button name="%(hr_hospital_patient_card_export_wizard_action)d" string="Export Card"
                            type="action" class="oe_highlight"
                            context="{'default_patient_id': active_id}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <notebook>

                        <!-- TAB: General Info & Contacts -->
                        <page name="general_info" string="General Info">
                            <group>
                                <group string="Personal Data">
                                    <field name="last_name"/>
                                    <field name="first_name"/>
                                    <field name="middle_name"/>
                                    <field name="gender"/>
                                    <field name="birth_date"/>
                                    <field name="age"/>
                                    <field name="passport_data"/>
                                    <field name="country_id"/>
                                </group>
                                <group string="Contact Details">
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="language_id"/>
                                    <field name="contact_person_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB: Medical Info -->
                        <page name="medical_info" string="Medical Info">
                            <group>
                                <group string="Key Medical Data">
                                    <field name="blood_group"/>
                                </group>
                                <group string="Allergies">
                                    <field name="allergies"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB: Insurance -->
                        <page name="insurance_info" string="Insurance">
                            <group>
                                <group>
                                    <field name="insurance_company_id"/>
                                    <field name="insurance_policy_number"/>
                                </group>
                                <group/>
                            </group>
                        </page>

                        <!-- TAB: Doctor History -->
                        <page name="doctor_history" string="Doctors &amp; History">
                            <group>
                                <field name="personal_doctor_id"/>
                            </group>
                            <separator string="Personal Doctor History"/>
                            <field name="doctor_history_ids">
                                <tree editable="bottom">
                                    <field name="doctor_id"/>
                                    <field name="assignment_date"/>
                                    <field name="change_date"/>
                                    <field name="active"/>
                                    <field name="change_reason"/>
                                </tree>
                            </field>
                        </page>

                        <!-- TAB: Diagnosis History -->
                        <page name="diagnosis_history" string="Diagnosis History">

                            <separator string="Diagnosis History"/>
                            <field name="diagnosis_history_ids" readonly="1">
                                <tree>
                                    <field name="visit_date_related" string="Visit Date"/>
                                    <field name="doctor_related_id" string="Doctor"/>
                                    <field name="disease_id"/>
                                    <field name="severity_level"/>
                                    <field name="is_approved"/>
                                    <field name="approving_doctor_id"/>
                                </tree>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="hr_hospital_patient_search" model="ir.ui.view">
        <field name="name">hr.hospital.patient.search</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Patient Search">
                <field name="name" string="Full Name"/>
                <field name="phone"/>

                <filter string="Has phone" name="has_phone" domain="[('phone', '!=', None)]"/>
                <filter string="No phone" name="no_phone" domain="[('phone', '=', None)]"/>
                <separator/>
                <filter string="UA Phones" name="ua_phone" domain="[('phone', '=ilike', '+380%')]"/>
                <filter string="Non-UA Phones" name="not_ua_phone" domain="[('phone', 'not ilike', '+380%')]"/>


            </search>
        </field>
    </record>

    <record id="hr_hospital_patient_action_window" model="ir.actions.act_window">
        <field name="name">Patient</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">tree,form,search</field>
        <field name="search_view_id" ref="hr_hospital_patient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create patient's record.
            </p>
        </field>
    </record>

    <menuitem id="hr_hospital_patient_menu"
              name="Patient"
              parent="hr_hospital_menu_root"
              action="hr_hospital_patient_action_window"
              sequence="30"/>

</odoo>
