<odoo>

    <record id="hr_hospital_diagnosis_tree" model="ir.ui.view">
        <field name="name">hr.hospital.diagnosis.tree</field>
        <field name="model">hr.hospital.diagnosis</field>
        <field name="arch" type="xml">
            <tree string="Diagnoses">
                <field name="visit_id"/>
                <field name="disease_id"/>
                <field name="severity_level"/>
                <field name="is_approved" widget="boolean_toggle"/>
                <field name="approving_doctor_id"/>
                <field name="approval_date"/>
            </tree>
        </field>
    </record>

    <record id="hr_hospital_diagnosis_form" model="ir.ui.view">
        <field name="name">hr.hospital.diagnosis.form</field>
        <field name="model">hr.hospital.diagnosis</field>
        <field name="arch" type="xml">
            <form string="Diagnosis">
                <sheet>
                    <div class="oe_title">
                        <label for="disease_id" string="Diagnosis"/>
                        <h1>
                            <field name="disease_id" required="1" placeholder="Select the Disease"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="visit_id"/>
                            <field name="severity_level"/>
                        </group>
                        <group>
                            <field name="is_approved" widget="boolean_toggle"/>

                            <field name="approving_doctor_id"/>
                            <field name="approval_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="details" string="Diagnosis Details">
                            <field name="diagnosis_description" placeholder="Detailed description of the diagnosis..."/>
                        </page>
                        <page name="treatment" string="Prescribed Treatment">
                            <field name="prescribed_treatment" widget="html"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_diagnosis_action_window" model="ir.actions.act_window">
        <field name="name">Diagnoses</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.diagnosis</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first medical diagnosis
            </p>
        </field>
    </record>

    <menuitem id="hr_hospital_diagnosis_menu"
              name="Diagnoses"
              parent="hr_hospital_menu_root"
              action="hr_hospital_diagnosis_action_window"
              sequence="40"/>

</odoo>
