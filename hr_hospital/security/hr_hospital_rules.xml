<odoo>
    <record id="visit_patient_read_own_rule" model="ir.rule">
        <field name="name">Visit: Patient Read Own</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="groups" eval="[(4, ref('group_hr_hospital_patient'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('patient_id.user_id', '=', user.id)]</field>
    </record>

    <record model="ir.rule" id="visit_intern_all_own_rule">
        <field name="name">Visit: Intern All Own</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="groups" eval="[(4, ref('group_hr_hospital_intern'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">
            [
                ('doctor_id.user_id', '=', user.id),
                ('doctor_id.is_intern', '=', True)
            ]
        </field>
    </record>


    <record model="ir.rule" id="visit_doctor_all_own_and_interns_rule">
        <field name="name">Visit: Doctor All Own and Interns</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="groups" eval="[(4, ref('group_hr_hospital_doctor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">
            [
            '|',
                ('doctor_id.user_id', '=', user.id),
                ('doctor_id.mentor_id.user_id', '=', user.id)
            ]
        </field>
    </record>

    <record model="ir.rule" id="visit_manager_read_all_rule">
        <field name="name">Visit: Manager Read All</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="groups" eval="[(4, ref('group_hr_hospital_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record model="ir.rule" id="visit_admin_all_rule">
        <field name="name">Visit: Admin All</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="groups" eval="[(4, ref('group_hr_hospital_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
